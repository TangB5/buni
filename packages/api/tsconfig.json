{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "@buni/ui": ["../ui/src/index.ts"],
      "@buni/tokens": ["../tokens/src/index.ts"],
      "@buni/patterns": ["../patterns/src/index.ts"],
      "@buni/icons": ["../icons/src/index.ts"],
      "@buni/auth": ["../auth/src/index.ts"],
      "@buni/api": ["."],
      "@buni/config": ["../config/src/index.ts"],
      "@buni/analytics": ["../analytics/src/index.ts"],
      "@buni/utils": ["../utils/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
