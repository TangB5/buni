# Backend Buni (avs-backend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
# Redirect URI à déclarer : http://localhost:3000/api/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OAuth — GitHub (https://github.com/settings/developers)
# Callback URL à déclarer : http://localhost:3000/api/auth/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Origine utilisée pour construire les redirect_uri (optionnel, sinon origine de la requête)
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
